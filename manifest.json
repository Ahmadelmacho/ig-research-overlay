{
  "manifest_version": 3,
  "name": "IG Research Overlay",
  "version": "0.2.0",
  "description": "Local, passive overlay of public Instagram engagement metrics and exact publish time. Reads only data Instagram already loads; makes no network requests of its own.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_title": "IG Research Overlay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "inject.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ]
    }
  ]
}
